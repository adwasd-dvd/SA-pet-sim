{
  "name": "sa-pet-sim",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-10",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAP_ROOMS",
        "class_name": "MapRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-map-rooms",
      "new_sqlite_classes": [
        "MapRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
