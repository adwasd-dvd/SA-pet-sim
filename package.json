{
  "name": "stoneage-web-rebuild",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:world": "node scripts/build-world.mjs && node scripts/extract-client-tiles.mjs",
    "build:world:dry-run": "SA_BUILD_WORLD_DRY_RUN=1 node scripts/build-world.mjs",
    "build:world:classic-core:dry-run": "SA_CONTENT_PROFILE=classic-core SA_BUILD_WORLD_DRY_RUN=1 node scripts/build-world.mjs",
    "build:world:classic-core": "SA_CONTENT_PROFILE=classic-core node scripts/build-world.mjs && node scripts/extract-client-tiles.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:maps": "node scripts/check-map-atlas.mjs",
    "check:movement": "node scripts/check-movement-collision.mjs",
    "check:npc": "node scripts/check-npc-actions.mjs",
    "check:npc-scripts": "node scripts/report-npc-script-coverage.mjs --check",
    "check:assist-ui": "node scripts/check-assist-route-ui.mjs",
    "check:battle-ui": "node scripts/check-battle-ui.mjs",
    "check:realtime": "node scripts/check-realtime-room.mjs",
    "check:protocol": "node scripts/check-worker-protocol.mjs",
    "check:pet-assets": "node scripts/check-pet-asset-resolution.mjs",
    "check:profile-runtime-packs": "node scripts/check-profile-runtime-packs.mjs",
    "report:npc-scripts": "node scripts/report-npc-script-coverage.mjs",
    "report:pet-resources": "node scripts/report-pet-resource-coverage.mjs",
    "report:pet-animations": "node scripts/report-pet-animation-coverage.mjs",
    "profile:pet-field:classic-core": "node scripts/build-pet-field-animation-pack.mjs",
    "audit:classic-core": "node scripts/audit-classic-core-content.mjs",
    "closure:classic-core": "node scripts/build-classic-content-closure.mjs",
    "report:classic-core": "node scripts/report-classic-core-package.mjs",
    "profile:keep-set:classic-core": "node scripts/resource-tools/build-texture-keep-set.mjs public/data/client-tiles/tiles.json --world=src/world-data.js --enemybase=public/data/enemybase2.txt --closure=docs/planning/classic-core-closure-manifest.json --profile=classic-core --maps=public/data/maps --client-maps=public/data/client-maps --out=public/data/profiles/classic-core/texture-keep-set.json",
    "profile:plan-packs:classic-core": "node scripts/resource-tools/plan-texture-packs.mjs public/data/client-tiles/tiles.json public/data/profiles/classic-core/texture-keep-set.json --start-floor=1000 --out=public/data/profiles/classic-core/profile-texture-pack-plan.json",
    "profile:build-packs:classic-core": "node scripts/resource-tools/build-texture-packs-from-atlas.mjs public/data/client-tiles/tiles-atlas.png public/data/client-tiles/tiles.json public/data/profiles/classic-core/profile-texture-pack-plan.json --out-dir=public/data/profiles/classic-core/packs --report=public/data/profiles/classic-core/texture-pack-build-report.json --verify-output",
    "profile:validate-packs:classic-core": "node scripts/resource-tools/validate-profile-packs.mjs public/data/client-tiles/tiles.json public/data/profiles/classic-core/texture-keep-set.json public/data/profiles/classic-core/profile-texture-pack-plan.json --packs-dir=public/data/profiles/classic-core/packs --report=public/data/profiles/classic-core/validate-profile-packs-report.json && node scripts/resource-tools/compare-pack-rendering.mjs public/data/client-tiles/tiles-atlas.png public/data/client-tiles/tiles.json public/data/profiles/classic-core/profile-texture-pack-plan.json --packs-dir=public/data/profiles/classic-core/packs --report=public/data/profiles/classic-core/compare-pack-rendering-report.json",
    "profile:assets:classic-core": "npm run profile:keep-set:classic-core && npm run profile:plan-packs:classic-core && npm run profile:build-packs:classic-core && npm run profile:validate-packs:classic-core && npm run profile:pet-field:classic-core",
    "package:transfer": "node scripts/package-transfer.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "npm run check:maps && npm run check:movement && npm run check:npc && npm run check:npc-scripts && npm run check:assist-ui && npm run check:battle-ui && npm run check:realtime && npm run check:protocol && npm run check:pet-assets && npm run check:profile-runtime-packs && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.15.0"
  }
}
